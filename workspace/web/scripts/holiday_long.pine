//@version=5
// Long into US market holidays (from the journal's Swing → Holidays study). Use on a DAILY chart (SPY, QQQ, IWM, DIA).
//   Buy at the close N sessions before a chosen market holiday, sell at the close of the last session before it
//   (or of the first session after it). The holidays come from the NYSE rules, so the strategy knows them in advance.
//   Defaults = the study's selection: Presidents' Day, Good Friday, Memorial Day, Independence Day, Thanksgiving,
//   Christmas (New Year's Day, Martin Luther King Jr. Day, Juneteenth and Labor Day left out).
strategy("Long into US holidays", "Holiday long", overlay = true, initial_capital = 100000, default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100, process_orders_on_close = true, commission_type = strategy.commission.percent, commission_value = 0.01)

nSess   = input.int(5, "Buy N sessions before the holiday", minval = 1, maxval = 15)
exitAt  = input.string("The close before the holiday", "Sell at", options = ["The close before the holiday", "The close of the first session after"])
grpH = "Holidays traded"
onNY    = input.bool(false, "New Year's Day", group = grpH)
onMLK   = input.bool(false, "Martin Luther King Jr. Day", group = grpH)
onPres  = input.bool(true, "Presidents' Day", group = grpH)
onGF    = input.bool(true, "Good Friday", group = grpH)
onMem   = input.bool(true, "Memorial Day", group = grpH)
onJune  = input.bool(false, "Juneteenth", group = grpH)
onInd   = input.bool(true, "Independence Day", group = grpH)
onLab   = input.bool(false, "Labor Day", group = grpH)
onThx   = input.bool(true, "Thanksgiving", group = grpH)
onXmas  = input.bool(true, "Christmas", group = grpH)
showNext = input.bool(true, "Show the next trade")

DAY = 86400000

// the date of a bar: daily bars are stamped at midnight UTC here and at the open on TradingView; +6 h is the same date in both
dayTs(t) =>
    t6 = t + 6 * 3600000
    timestamp("UTC", year(t6, "UTC"), month(t6, "UTC"), dayofmonth(t6, "UTC"), 0, 0)

ymdTs(y, m, d) => timestamp("UTC", y, m, d, 0, 0)

// the n-th weekday (1 = Sunday ... 7 = Saturday, Pine numbering) of a month; n = -1: the last one
nthDow(y, m, dow, n) =>
    int r = 0
    if n > 0
        first = ymdTs(y, m, 1)
        off = (dow - dayofweek(first, "UTC") + 7) % 7
        r := first + (off + 7 * (n - 1)) * DAY
    else
        last = ymdTs(m == 12 ? y + 1 : y, m == 12 ? 1 : m + 1, 1) - DAY
        off = (dayofweek(last, "UTC") - dow + 7) % 7
        r := last - off * DAY
    r

// Saturday -> Friday, Sunday -> Monday
observed(ts) =>
    w = dayofweek(ts, "UTC")
    w == dayofweek.saturday ? ts - DAY : w == dayofweek.sunday ? ts + DAY : ts

easterTs(y) =>
    a = y % 19
    b = math.floor(y / 100)
    c = y % 100
    d = math.floor(b / 4)
    e = b % 4
    f = math.floor((b + 8) / 25)
    g = math.floor((b - f + 1) / 3)
    h = (19 * a + b - d - g + 15) % 30
    i = math.floor(c / 4)
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = math.floor((a + 11 * h + 22 * l) / 451)
    mo = math.floor((h + l - 7 * m + 114) / 31)
    dd = (h + l - 7 * m + 114) % 31 + 1
    ymdTs(y, mo, dd)

// the NYSE holidays of a year, in the order of the inputs (1..10); New Year's Day on a Sunday moves to Monday Jan 2,
// on a Saturday it is not moved (the market is open on Dec 31)
var hDates = array.new_int()
var hIds = array.new_int()
var int hYear = na
addYear(y) =>
    ny = ymdTs(y, 1, 1)
    nyW = dayofweek(ny, "UTC")
    if nyW != dayofweek.saturday
        array.push(hDates, nyW == dayofweek.sunday ? ny + DAY : ny)
        array.push(hIds, 1)
    if y >= 1998
        array.push(hDates, nthDow(y, 1, dayofweek.monday, 3))
        array.push(hIds, 2)
    array.push(hDates, nthDow(y, 2, dayofweek.monday, 3))
    array.push(hIds, 3)
    array.push(hDates, easterTs(y) - 2 * DAY)
    array.push(hIds, 4)
    array.push(hDates, nthDow(y, 5, dayofweek.monday, -1))
    array.push(hIds, 5)
    if y >= 2022
        array.push(hDates, observed(ymdTs(y, 6, 19)))
        array.push(hIds, 6)
    array.push(hDates, observed(ymdTs(y, 7, 4)))
    array.push(hIds, 7)
    array.push(hDates, nthDow(y, 9, dayofweek.monday, 1))
    array.push(hIds, 8)
    array.push(hDates, nthDow(y, 11, dayofweek.thursday, 4))
    array.push(hIds, 9)
    array.push(hDates, observed(ymdTs(y, 12, 25)))
    array.push(hIds, 10)
    0

holidayAt(ts) =>
    k = array.indexof(hDates, ts)
    k >= 0 ? array.get(hIds, k) : 0

enabled(h) => h == 1 ? onNY : h == 2 ? onMLK : h == 3 ? onPres : h == 4 ? onGF : h == 5 ? onMem : h == 6 ? onJune : h == 7 ? onInd : h == 8 ? onLab : h == 9 ? onThx : h == 10 ? onXmas : false
hname(h) => h == 1 ? "New Year's Day" : h == 2 ? "MLK Day" : h == 3 ? "Presidents' Day" : h == 4 ? "Good Friday" : h == 5 ? "Memorial Day" : h == 6 ? "Juneteenth" : h == 7 ? "Independence Day" : h == 8 ? "Labor Day" : h == 9 ? "Thanksgiving" : "Christmas"

// the holidays of this year and the next (built once a year)
today = dayTs(time)
if na(hYear) or year(today, "UTC") != hYear
    hYear := year(today, "UTC")
    array.clear(hDates)
    array.clear(hIds)
    addYear(hYear)
    addYear(hYear + 1)

// the next traded holiday within 25 days, and the sessions left before it (this one excluded): once a day
var int target = 0
var int tName = 0
var int left = 0
var int dayDone = na
if na(dayDone) or today != dayDone
    dayDone := today
    target := 0
    tName := 0
    left := 0
    for k = 1 to 25
        dk = today + k * DAY
        w = dayofweek(dk, "UTC")
        if w != dayofweek.saturday and w != dayofweek.sunday
            h = holidayAt(dk)
            if h > 0
                if enabled(h)
                    target := dk
                    tName := h
                    break
            else
                left += 1

// was yesterday's session followed by a traded holiday (for "the first session after")
var int prevLeftZero = 0
afterHoliday = prevLeftZero > 0

if exitAt == "The close before the holiday"
    if strategy.position_size > 0 and target > 0 and left == 0
        strategy.close_all(comment = "before " + hname(tName))
else
    if strategy.position_size > 0 and afterHoliday
        strategy.close_all(comment = "after " + hname(prevLeftZero))

if strategy.position_size == 0 and target > 0 and left == nSess
    strategy.entry("Long", strategy.long, comment = hname(tName))

// safety: never held more than N + 3 sessions
var int held = 0
held := strategy.position_size > 0 ? held + 1 : 0
if held > nSess + 3
    strategy.close_all(comment = "time")

prevLeftZero := target > 0 and left == 0 ? tName : 0

var label nxt = na
if showNext and barstate.islast and target > 0
    label.delete(nxt)
    nxt := label.new(bar_index, high, "Next: " + hname(tName) + " " + str.format_time(target, "yyyy-MM-dd", "UTC") + (left >= nSess ? " · buy in " + str.tostring(left - nSess) + " session(s)" : " · in the trade window"),
         style = label.style_label_down, color = color.new(#3b82f6, 30), textcolor = color.white, size = size.small)
